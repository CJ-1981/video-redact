{
  "name": "video-redact",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "SPEC-VID-001 — client-side video redaction web app (single-file build; faces/plates pixelated, burned in at export, nothing leaves the machine).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "node tools/inline.mjs",
    "lint": "eslint src tools",
    "typecheck": "tsc --noEmit",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@mediabunny/prores": "1.63.0"
  }
}
